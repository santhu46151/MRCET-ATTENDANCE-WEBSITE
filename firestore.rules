rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (getUserData().role == role || getUserData().role == role.toLowerCase());
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@mrcet.edu' ||
        hasRole('admin')
      );
    }

    function isHOD() {
      return isAdmin() || hasRole('hod');
    }

    function isFaculty() {
      return isHOD() || hasRole('faculty') || hasRole('incharge') || hasRole('class_incharge');
    }

    function isStudent() {
      return isAuthenticated() && (hasRole('student') || !isFaculty());
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // Anyone authenticated can read user documents (needed for incharge/faculty verification)
      allow read: if isAuthenticated();
      // Users can write their own profile upon registration; Admins have full access
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. Classes & Rosters Collection
    // ==========================================
    match /classes/{classId} {
      // All authenticated users can read class data (students read their roster/history; staff reads all)
      allow read: if isAuthenticated();
      // Only Faculty, Incharge, HOD, and Admin can update attendance records or student rosters
      allow write: if isFaculty() || isAdmin();
    }

    // ==========================================
    // 3. Timetables Collection
    // ==========================================
    match /timetables/{timetableId} {
      // All authenticated users can read timetables
      allow read: if isAuthenticated();
      // Admin and HOD can manage timetables
      allow write: if isAdmin() || isHOD();
    }

    // ==========================================
    // 4. Attendance Requests (Student Self-Attendance)
    // ==========================================
    match /attendance_requests/{requestId} {
      // Students can read their own requests; Faculty, Incharge, HOD, and Admin can view all requests
      allow read: if isAuthenticated();
      // Students can create a self-attendance request with status "Pending"
      allow create: if isAuthenticated() && request.resource.data.status == 'Pending';
      // Only Faculty, Class Incharge, HOD, and Admin can approve or reject attendance requests
      allow update: if isFaculty() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. Notifications Collection
    // ==========================================
    match /notifications/{notificationId} {
      // Authenticated users can read notifications
      allow read: if isAuthenticated();
      // System or students can create notifications (e.g. self-attendance request alerts)
      allow create: if isAuthenticated();
      // Staff or recipient can update (e.g. mark as read)
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 6. Audit Logs (Student Detail Updates & Overrides)
    // ==========================================
    match /audit_logs/{logId} {
      // Faculty, Incharge, HOD, and Admin can read audit logs
      allow read: if isFaculty() || isAdmin();
      // Authorized staff can create audit records
      allow create: if isFaculty() || isAdmin();
      // Audit logs are immutable — no updates or deletes allowed
      allow update, delete: if false;
    }

    // ==========================================
    // 7. Holidays & Calendar Collection
    // ==========================================
    match /holidays/{holidayId} {
      // All authenticated users can read holidays
      allow read: if isAuthenticated();
      // Only Admin and HOD can declare holidays
      allow write: if isAdmin() || isHOD();
    }
  }
}
