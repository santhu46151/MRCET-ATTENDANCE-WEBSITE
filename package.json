{
  "name": "attendance-website",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:web": "npx copyfiles -f \"*.html\" \"*.css\" \"*.js\" \"logo.png\" www",
    "cap:sync": "npm run build:web && npx cap sync"
  },
  "build": {
    "appId": "com.mrcet.attendance",
    "productName": "MRCET Attendance",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhu46151/MRCET-ATTENDANCE-WEBSITE.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/santhu46151/MRCET-ATTENDANCE-WEBSITE/issues"
  },
  "homepage": "https://github.com/santhu46151/MRCET-ATTENDANCE-WEBSITE#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "copyfiles": "^2.4.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
